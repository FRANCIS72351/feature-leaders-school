# AWS / Docker production template
# Copy to .env on the server or inject via ECS/EB/App Runner secrets.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# --- Required ---
SECRET_KEY=REPLACE_WITH_python_-c_import_secrets_print_secrets_token_hex_32
FLASK_ENV=production
PRODUCTION=1
DOCKER=1

# Public HTTPS URL (required for parent QR codes and student ID verification)
SITE_URL=https://school.example.com

# --- Database ---
# Option A: SQLite on a mounted EBS/EFS volume (single container only)
DATABASE_URL=sqlite:////app/instance/keeptrack_full.db
WEB_CONCURRENCY=1

# Option B: Amazon RDS PostgreSQL (recommended for production / scaling)
# DATABASE_URL=postgresql+psycopg2://schooluser:PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/school_db
# WEB_CONCURRENCY=2

# First deploy only — creates empty tables and admin user, then set to 0
FRESH_DATABASE=1
ADMIN_EMAIL=admin@school.com
ADMIN_NAME=School Administrator
ADMIN_PASSWORD=set_a_strong_password_here

# --- Gunicorn (container listens on all interfaces) ---
PORT=8000
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_PRELOAD=true

# --- HTTPS behind ALB / CloudFront / Nginx ---
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
PROXY_FIX_HOPS=1
WTF_CSRF_SSL_STRICT=true

# --- Upload limits ---
MAX_UPLOAD_MB=16
SCHOOL_VIDEO_MAX_MB=150
SCHOOL_VIDEO_MAX_DURATION_SEC=180

# --- Optional: docker compose --profile postgres ---
# POSTGRES_PASSWORD=change_me_in_production
