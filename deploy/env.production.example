# Production environment — copy to /etc/school-management/env on Linux VPS
# chmod 600 /etc/school-management/env

SECRET_KEY=REPLACE_WITH_python3_-c_import_secrets_print_secrets_token_hex_32
FLASK_ENV=production
PRODUCTION=1

DATABASE_URL=sqlite:////var/www/school-management/instance/keeptrack_full.db

# Public HTTPS address printed into parent report-card and student ID QR codes.
# No trailing slash. Phones cannot open localhost.
SITE_URL=https://flpa2015.com
PUBLIC_SITE_URL=https://flpa2015.com

# Existing production data is preserved on every deploy and restart.
# Keep this at 0 for an existing installation. Never set it to 1 in production.
FRESH_DATABASE=0
ADMIN_EMAIL=admin@school.com
ADMIN_NAME=School Administrator
ADMIN_PASSWORD=set_a_strong_password_here

GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_PRELOAD=true
GZIP_MIN_BYTES=500
STATIC_CACHE_SECONDS=2592000
DASHBOARD_PAGE_SIZE=50
# After migrating to PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://schooluser:PASSWORD@127.0.0.1:5432/school_db
# WEB_CONCURRENCY=4
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

SESSION_COOKIE_SECURE=true
PROXY_FIX_HOPS=1
MAX_UPLOAD_MB=16
