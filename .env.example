# Copy to .env for local dev, or to /etc/school-management/env for production.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# --- Required in production ---
SECRET_KEY=change_this_to_a_long_random_string
FLASK_ENV=production
PRODUCTION=1

# --- Database ---
# Default: SQLite in instance/keeptrack_full.db (fine for small/medium schools)
# DATABASE_URL=sqlite:////var/www/school-management/instance/keeptrack_full.db
# For larger deployments use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://schooluser:password@127.0.0.1:5432/school_db
#
# On VPS first install: FRESH_DATABASE=1 wipes instance/*.db and creates empty tables.
# Your local development database is gitignored and never pushed to GitHub.
# FRESH_DATABASE=1

# --- Server bind (Gunicorn reads GUNICORN_BIND; app uses PORT for docs) ---
PORT=8000
GUNICORN_BIND=127.0.0.1:8000
# SQLite: keep WEB_CONCURRENCY=1 (max 2). Postgres: 2–(2*CPU+1).
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
# Windows / python app.py (Waitress)
WAITRESS_THREADS=16
WAITRESS_CONNECTION_LIMIT=200
# Postgres pool per worker (not used for SQLite)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Gzip HTML/JSON when clients send Accept-Encoding: gzip
GZIP_MIN_BYTES=500
STATIC_CACHE_SECONDS=2592000
DASHBOARD_PAGE_SIZE=50

# --- HTTPS behind Nginx ---
SESSION_COOKIE_SECURE=true
PROXY_FIX_HOPS=1

# --- Public URL for QR codes (parent report cards, student ID portal) ---
# Required so phones can open printed QR codes. Do not use localhost. No trailing slash.
# Production example:
# SITE_URL=https://school.example.com
# VS Code / GitHub Dev Tunnels (copy the https://*.devtunnels.ms origin you open in the browser):
# SITE_URL=https://wb9jv14t-3000.uks1.devtunnels.ms
# PUBLIC_SITE_URL is accepted as an alias. Restart the app, then reprint ID cards.

# --- Uploads (sizes in megabytes per file — not a count of files) ---
# Photos, documents, and student assignment files: max size of ONE file
MAX_UPLOAD_MB=16
# School promo videos: max size of ONE video file, and max length in seconds
# (150 MB, 180 seconds = 3 minutes). No limit on how many videos you can upload.
SCHOOL_VIDEO_MAX_MB=150
SCHOOL_VIDEO_MAX_DURATION_SEC=180

# --- AWS / Docker (see DEPLOY_AWS.md) ---
# DOCKER=1
# GUNICORN_BIND=0.0.0.0:8000
# Copy .env.production.example for a full production template.
